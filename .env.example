# Conexión a PostgreSQL (Neon). Copia este archivo a .env y rellena los valores.
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-ejemplo-xxxxx.us-east-2.aws.neon.tech/life-dashboard?sslmode=require"

# Cuenta única: se crea el usuario administrador la primera vez que se ejecuta el seed.
ADMIN_EMAIL="tu@correo.com"
ADMIN_PASSWORD="cambia-esta-contrasena"
ADMIN_NAME="Tu Nombre"
ADMIN_TIMEZONE="Europe/Madrid"